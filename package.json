{
  "name": "qa-serverest",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run --browser chrome",
    "cy:run:api": "cypress run --browser chrome --spec cypress/e2e/api/**",
    "cy:run:e2e": "cypress run --browser chrome --spec cypress/e2e/frontend/**",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "allure:report": "allure generate allure-results --clean -o allure-report",
    "cy:record": "cypress run --browser chrome --record --key  --config projectId=",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meloigor/qa-serverest.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/meloigor/qa-serverest/issues"
  },
  "homepage": "https://github.com/meloigor/qa-serverest#readme",
  "devDependencies": {
    "@cypress/grep": "^7.0.0",
    "@faker-js/faker": "^10.6.0",
    "allure-cypress": "^3.14.0",
    "cypress": "^16.3.0",
    "cypress-dotenv": "^3.0.1",
    "cypress-network-idle": "^2.0.1",
    "cypress-plugin-steps": "^1.2.2",
    "cypress-schema-validator": "^2.0.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-cypress": "^7.0.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.10.1"
  },
  "allowScripts": {
    "cypress@16.3.0": true
  },
  "lint-staged": {
    "*.{js,json}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
